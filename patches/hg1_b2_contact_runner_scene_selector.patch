+def select_scene_config(root: Path, assembly: str,
+                        override: Path | None) -> Path:
+    """Keep the historical default unless a diagnostic opts into a scene."""
+    if assembly not in ("franka", "robotiq"):
+        raise ValueError("Unknown assembly")
+    if override is not None:
+        return override.resolve()
+    name = ("fr3_droid_scene.json" if assembly == "franka"
+            else "fr3_droid_robotiq_scene.json")
+    return root / "sim/configs" / name
+
+
+def require_selected_scene(reviewed: dict, selected: Path,
+                           label: str) -> None:
+    """Prevent a reviewed collider report or plan crossing scene revisions."""
+    if reviewed.get("source_config") != str(selected.resolve()):
+        raise ValueError(f"{label} scene config mismatch")
 
 
